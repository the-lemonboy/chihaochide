<view class="shell"><view class="topbar"><text class="brand">🥢 小林小郑吃好吃的</text><navigator url="/pages/list/list" class="link">看看收藏</navigator></view><view class="hero"><text class="eyebrow">FOOD MOOD · 01</text><text class="title">今天<text class="pink">吃好吃的</text></text><text class="sub">选择困难没关系，菜单替你操心</text></view><view class="card"><view class="section"><view><text class="heading">想吃什么</text><text class="muted">先圈起来，纠结稍后再说</text></view><text class="count">{{selected.length}} 家</text></view><view wx:for="{{places}}" wx:key="id" class="place {{item.color}} {{item.selected?'chosen':''}}" data-id="{{item.id}}" bindtap="toggle"><text class="food">{{item.emoji}}</text><view class="copy"><text class="name">{{item.name}}</text><text class="muted">{{item.tag}}</text></view><text class="check">{{item.selected?'✓':''}}</text></view><view wx:if="{{!places.length}}" class="empty">🍽️<text>还没有候选餐厅</text></view></view><view class="draw"><button class="drawbtn" bindtap="draw" disabled="{{!selected.length}}">🎲 随便挑一家</button><text class="hint">点一下，看看今天的胃口有什么主意</text></view><view wx:if="{{result}}" class="mask"><view class="modal"><text class="eyebrow">TODAY'S PICK</text><text class="resultfood">{{result.emoji}}</text><text class="muted">抽到的是</text><text class="resultname">{{result.name}}</text><text class="muted">{{result.tag}}</text><button class="again" bindtap="draw">不服，再抽</button><button bindtap="close">行，就它了</button></view></view></view>
