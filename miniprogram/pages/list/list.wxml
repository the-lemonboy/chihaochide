<view class="shell"><view class="topbar"><text class="brand">📒 美食清单</text><navigator url="/pages/index/index" class="link">回到选择</navigator></view><view class="hero"><text class="eyebrow">MY FOOD LIBRARY</text><text class="title">把想吃的，<text class="pink">先记下来。</text></text></view><view class="card"><view class="section"><text class="heading">我的美食收藏</text><text class="count">{{places.length}} 家</text></view><view wx:for="{{places}}" wx:key="id" class="place {{item.color}}"><text class="food">{{item.emoji}}</text><view class="copy"><text class="name">{{item.name}}</text><text class="muted">{{item.tag}}</text></view><button class="candidate {{item.selected?'active':''}}" data-id="{{item.id}}" bindtap="toggle">{{item.selected?'已选中 ✓':'加入选择'}}</button><button class="delete" data-id="{{item.id}}" bindtap="remove">×</button></view><view class="form"><input placeholder="店名或想吃的美食" value="{{name}}" bindinput="nameInput"/><input placeholder="类型（可选）" value="{{tag}}" bindinput="tagInput"/><button class="drawbtn" bindtap="add">＋ 放进清单</button></view></view></view>
