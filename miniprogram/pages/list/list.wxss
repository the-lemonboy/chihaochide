page{background:#f6eee7}.shell{min-height:100vh;background:#fffaf4;padding:24rpx 36rpx;color:#302d3b}.topbar,.section{display:flex;justify-content:space-between;align-items:center}.brand{font-size:38rpx;font-weight:800}.link,.pink{color:#f06473}.hero{text-align:center;padding:75rpx 0 55rpx}.eyebrow{display:block;color:#aaa1a0;font-size:22rpx;letter-spacing:5rpx;font-weight:800}.title{display:block;font-size:58rpx;font-weight:900;margin-top:20rpx}.card{background:#fff;border:2rpx solid #f2e9e1;border-radius:40rpx;padding:38rpx 30rpx}.heading{font-size:36rpx;font-weight:900}.count{color:#f06473;background:#fff0ee;padding:12rpx 20rpx;border-radius:30rpx}.place{display:flex;align-items:center;padding:20rpx;border-radius:28rpx;margin-top:18rpx}.peach{background:#fff0e9}.yellow{background:#fff8da}.lavender{background:#f1efff}.mint{background:#e9f8ef}.blue{background:#eaf3ff}.food{font-size:52rpx;width:80rpx}.copy{display:flex;flex-direction:column}.name{font-size:29rpx;font-weight:800}.muted{color:#918d9d;font-size:25rpx}.candidate{margin-left:auto;font-size:22rpx;padding:12rpx;background:#fff;color:#777}.candidate.active{background:#f06473;color:#fff}.delete{font-size:40rpx;background:none;color:#999}.form{border-top:2rpx solid #eee1d8;margin-top:30rpx;padding-top:20rpx}.form input{border:2rpx solid #eee1d8;border-radius:20rpx;padding:18rpx;margin:8rpx 0}.drawbtn{background:#f06473;color:#fff;border-radius:25rpx;font-weight:900;margin-top:15rpx}
