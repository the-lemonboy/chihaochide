page{background:#f6eee7}.shell{min-height:100vh;background:#fffaf4;padding:24rpx 30rpx;color:#302d3b}.topbar,.section{display:flex;justify-content:space-between;align-items:center}.topbar{gap:16rpx}.brand{font-size:34rpx;font-weight:800;white-space:nowrap;flex:1}.link,.pink{color:#f06473}.link{font-size:26rpx;white-space:nowrap;flex:none}.hero{text-align:center;padding:75rpx 0 55rpx}.eyebrow{display:block;color:#aaa1a0;font-size:22rpx;letter-spacing:5rpx;font-weight:800}.title{display:block;font-size:58rpx;font-weight:900;margin-top:20rpx}.card{background:#fff;border:2rpx solid #f2e9e1;border-radius:40rpx;padding:38rpx 24rpx}.heading{font-size:36rpx;font-weight:900}.count{color:#f06473;background:#fff0ee;padding:12rpx 20rpx;border-radius:30rpx}.place{display:flex;align-items:center;padding:20rpx 14rpx;border-radius:28rpx;margin-top:18rpx}.peach{background:#fff0e9}.yellow{background:#fff8da}.lavender{background:#f1efff}.mint{background:#e9f8ef}.blue{background:#eaf3ff}.food{font-size:50rpx;width:62rpx;flex:none}.copy{display:flex;flex-direction:column;min-width:0;flex:1}.name{font-size:28rpx;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.muted{color:#918d9d;font-size:23rpx;white-space:nowrap}.candidate{flex:none;margin-left:8rpx;font-size:20rpx;padding:10rpx 11rpx;background:#fff;color:#777;white-space:nowrap}.candidate.active{background:#f06473;color:#fff}.delete{flex:none;width:40rpx;padding:0;font-size:36rpx;background:none;color:#999}.form{border-top:2rpx solid #eee1d8;margin-top:30rpx;padding-top:20rpx}.form input{border:2rpx solid #eee1d8;border-radius:20rpx;padding:18rpx;margin:8rpx 0}.drawbtn{background:#f06473;color:#fff;border-radius:25rpx;font-weight:900;margin-top:15rpx}
.candidate{box-sizing:border-box!important;width:150rpx!important;min-width:150rpx!important;height:58rpx!important;line-height:58rpx!important;margin:0 8rpx!important;padding:0!important;white-space:nowrap}.delete{box-sizing:border-box!important;width:44rpx!important;min-width:44rpx!important;height:58rpx!important;line-height:58rpx!important;margin:0!important;padding:0!important}
.candidate-check{box-sizing:border-box;flex:none;width:42rpx;height:42rpx;line-height:38rpx;text-align:center;border:2rpx solid #d7d1cf;border-radius:12rpx;background:#fff;color:#fff;font-size:28rpx}.candidate-check.active{background:#f06473;border-color:#f06473}
